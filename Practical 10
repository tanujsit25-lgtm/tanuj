<!DOCTYPE html>

<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">



    <title>Student Task Manager</title>



    <script src="https://cdn.tailwindcss.com"></script>

</head>



<body class="bg-gray-100 min-h-screen">



    <!-- Header -->

    <header class="bg-blue-600 text-white text-center py-6">

        <h1 class="text-3xl font-bold">

            Student Task Manager

        </h1>



        <p class="mt-2">

            Manage your study tasks easily

        </p>

    </header>





    <!-- Main Container -->

    <div class="max-w-3xl mx-auto p-5">



        <!-- Add Task -->

        <div class="bg-white p-6 rounded-xl shadow-md">



            <h2 class="text-2xl font-bold mb-4">

                Add New Task

            </h2>



            <input

                type="text"

                id="taskInput"

                placeholder="Enter task name"

                class="w-full border p-3 rounded-lg mb-3"

            >



            <input

                type="text"

                id="subjectInput"

                placeholder="Enter subject"

                class="w-full border p-3 rounded-lg mb-3"

            >



            <button

                onclick="addTask()"

                class="w-full bg-blue-600 text-white py-3 rounded-lg"

            >

                Add Task

            </button>



        </div>





        <!-- Task List -->

        <div class="bg-white p-6 rounded-xl shadow-md mt-6">



            <h2 class="text-2xl font-bold mb-4">

                My Tasks

            </h2>



            <div id="taskList"></div>



        </div>



    </div>





    <script>



        function addTask() {



            let taskInput =

                document.getElementById("taskInput");



            let subjectInput =

                document.getElementById("subjectInput");



            let task = taskInput.value;

            let subject = subjectInput.value;



            if (task === "" || subject === "") {



                alert("Please enter task and subject.");



                return;

            }



            let taskList =

                document.getElementById("taskList");



            let taskDiv =

                document.createElement("div");



            taskDiv.className =

                "border p-4 rounded-lg mb-3 flex " +

                "flex-col sm:flex-row justify-between gap-3";



            taskDiv.innerHTML = `

                <div>

                    <h3 class="font-bold text-lg">

                        ${task}

                    </h3>



                    <p class="text-gray-600">

                        Subject: ${subject}

                    </p>

                </div>



                <div class="flex gap-2">



                    <button

                        onclick="completeTask(this)"

                        class="bg-green-500 text-white px-3 py-2 rounded">

                        Complete

                    </button>



                    <button

                        onclick="deleteTask(this)"

                        class="bg-red-500 text-white px-3 py-2 rounded">

                        Delete

                    </button>



                </div>

            `;



            taskList.appendChild(taskDiv);



            taskInput.value = "";

            subjectInput.value = "";

        }





        function completeTask(button) {



            let taskDiv =

                button.parentElement.parentElement;



            taskDiv.classList.toggle("bg-green-100");



            button.innerText = "Completed";

        }





        function deleteTask(button) {



            let taskDiv =

                button.parentElement.parentElement;



            taskDiv.remove();

        }



    </script>



</body>

</html>
