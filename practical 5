<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Food Menu</title>

  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-orange-50">

  <!-- Header -->
  <header class="bg-orange-600 text-white text-center py-8">
    <h1 class="text-4xl font-bold">🍴 Tasty Bites</h1>
    <p class="mt-2 text-lg">Our Popular Food Menu</p>
  </header>

  <!-- Food Menu -->
  <section class="max-w-6xl mx-auto px-6 py-10">

    <h2 class="text-3xl font-bold text-center text-gray-800 mb-8">
      Popular Dishes
    </h2>

    <!-- Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">

      <!-- Card 1 -->
      <div class="bg-white rounded-xl shadow-lg overflow-hidden hover:shadow-2xl transition">
        <img
          src="https://images.unsplash.com/photo-1565299624946-b28f40a0ae38?auto=format&fit=crop&w=800&q=80"
          class="w-full h-52 object-cover"
          alt="Pizza">

        <div class="p-5">
          <h3 class="text-2xl font-bold text-gray-800">Cheese Pizza</h3>
          <p class="text-gray-600 mt-2">
            Delicious pizza topped with melted cheese and fresh vegetables.
          </p>

          <button class="mt-5 bg-orange-600 text-white px-5 py-2 rounded-lg
                         hover:bg-orange-700">
            Order Now
          </button>
        </div>
      </div>

      <!-- Card 2 -->
      <div class="bg-white rounded-xl shadow-lg overflow-hidden hover:shadow-2xl transition">
        <img
          src="https://images.unsplash.com/photo-1568901346375-23c9450c58cd?auto=format&fit=crop&w=800&q=80"
          class="w-full h-52 object-cover"
          alt="Burger">

        <div class="p-5">
          <h3 class="text-2xl font-bold text-gray-800">Classic Burger</h3>
          <p class="text-gray-600 mt-2">
            Juicy grilled burger served with fresh lettuce, tomato and cheese.
          </p>

          <button class="mt-5 bg-orange-600 text-white px-5 py-2 rounded-lg
                         hover:bg-orange-700">
            Order Now
          </button>
        </div>
      </div>

      <!-- Card 3 -->
      <div class="bg-white rounded-xl shadow-lg overflow-hidden hover:shadow-2xl transition">
        <img
          src="https://images.unsplash.com/photo-1553621042-f6e147245754?auto=format&fit=crop&w=800&q=80"
          class="w-full h-52 object-cover"
          alt="Pasta">

        <div class="p-5">
          <h3 class="text-2xl font-bold text-gray-800">Creamy Pasta</h3>
          <p class="text-gray-600 mt-2">
            Creamy Italian pasta prepared with herbs, vegetables and cheese.
          </p>

          <button class="mt-5 bg-orange-600 text-white px-5 py-2 rounded-lg
                         hover:bg-orange-700">
            Order Now
          </button>
        </div>
      </div>

      <!-- Card 4 -->
      <div class="bg-white rounded-xl shadow-lg overflow-hidden hover:shadow-2xl transition">
        <img
          src="https://images.unsplash.com/photo-1601050690597-df0568f70950?auto=format&fit=crop&w=800&q=80"
          class="w-full h-52 object-cover"
          alt="Samosa">

        <div class="p-5">
          <h3 class="text-2xl font-bold text-gray-800">Crispy Samosa</h3>
          <p class="text-gray-600 mt-2">
            Golden crispy samosas filled with spicy potatoes and aromatic spices.
          </p>

          <button class="mt-5 bg-orange-600 text-white px-5 py-2 rounded-lg
                         hover:bg-orange-700">
            Order Now
          </button>
        </div>
      </div>

      <!-- Card 5 -->
      <div class="bg-white rounded-xl shadow-lg overflow-hidden hover:shadow-2xl transition">
        <img
          src="https://images.unsplash.com/photo-1551024506-0bccd828d307?auto=format&fit=crop&w=800&q=80"
          class="w-full h-52 object-cover"
          alt="Donut">

        <div class="p-5">
          <h3 class="text-2xl font-bold text-gray-800">Chocolate Donut</h3>
          <p class="text-gray-600 mt-2">
            Soft and delicious donut covered with rich chocolate glaze.
          </p>

          <button class="mt-5 bg-orange-600 text-white px-5 py-2 rounded-lg
                         hover:bg-orange-700">
            Order Now
          </button>
        </div>
      </div>

      <!-- Card 6 -->
      <div class="bg-white rounded-xl shadow-lg overflow-hidden hover:shadow-2xl transition">
        <img
          src="https://images.unsplash.com/photo-1551024709-8f23befc6f87?auto=format&fit=crop&w=800&q=80"
          class="w-full h-52 object-cover"
          alt="Dessert">

        <div class="p-5">
          <h3 class="text-2xl font-bold text-gray-800">Sweet Dessert</h3>
          <p class="text-gray-600 mt-2">
            A delightful dessert to finish your meal with a sweet taste.
          </p>

          <button class="mt-5 bg-orange-600 text-white px-5 py-2 rounded-lg
                         hover:bg-orange-700">
            Order Now
          </button>
        </div>
      </div>

    </div>
  </section>

  <!-- Footer -->
  <footer class="bg-gray-900 text-white text-center py-5">
    <p>© 2026 Tasty Bites | Delicious Food, Happy Life 🍕</p>
  </footer>

</body>
</html>
