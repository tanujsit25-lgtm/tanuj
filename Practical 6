<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Marks Calculator</title>

    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="min-h-screen bg-gradient-to-br from-pink-400 via-cyan-200 to-red-300 flex items-center justify-center p-5">

    <div class="bg-white rounded-2xl shadow-2xl p-6 w-full max-w-2xl">

        <!-- Heading -->
        <h1 class="text-3xl font-bold text-center text-purple-700 mb-2">
            MDM PRACTICAL No. 6
        </h1>

        <p class="text-center text-gray-600 mb-6 text-xl font-semibold">
            Marks Calculator
        </p>


        <!-- Marks Table -->
        <table class="w-full border-collapse border border-gray-400">

            <thead>
                <tr class="bg-purple-600 text-white">
                    <th class="border border-gray-400 p-3">#</th>
                    <th class="border border-gray-400 p-3">Subject</th>
                    <th class="border border-gray-400 p-3">Marks</th>
                </tr>
            </thead>

            <tbody>

                <tr>
                    <td class="border border-gray-400 p-3 text-center">1</td>
                    <td class="border border-gray-400 p-3 font-semibold">DMGT</td>
                    <td class="border border-gray-400 p-3">
                        <input
                            type="number"
                            id="DMGT"
                            placeholder="Enter marks"
                            class="w-full border rounded-lg p-2">
                    </td>
                </tr>

                <tr>
                    <td class="border border-gray-400 p-3 text-center">2</td>
                    <td class="border border-gray-400 p-3 font-semibold">CAO</td>
                    <td class="border border-gray-400 p-3">
                        <input
                            type="number"
                            id="CAO"
                            placeholder="Enter marks"
                            class="w-full border rounded-lg p-2">
                    </td>
                </tr>

                <tr>
                    <td class="border border-gray-400 p-3 text-center">3</td>
                    <td class="border border-gray-400 p-3 font-semibold">ED</td>
                    <td class="border border-gray-400 p-3">
                        <input
                            type="number"
                            id="ED"
                            placeholder="Enter marks"
                            class="w-full border rounded-lg p-2">
                    </td>
                </tr>

                <tr>
                    <td class="border border-gray-400 p-3 text-center">4</td>
                    <td class="border border-gray-400 p-3 font-semibold">ES</td>
                    <td class="border border-gray-400 p-3">
                        <input
                            type="number"
                            id="ES"
                            placeholder="Enter marks"
                            class="w-full border rounded-lg p-2">
                    </td>
                </tr>

                <tr>
                    <td class="border border-gray-400 p-3 text-center">5</td>
                    <td class="border border-gray-400 p-3 font-semibold">MDM</td>
                    <td class="border border-gray-400 p-3">
                        <input
                            type="number"
                            id="MDM"
                            placeholder="Enter marks"
                            class="w-full border rounded-lg p-2">
                    </td>
                </tr>

            </tbody>
        </table>


        <!-- Calculate Button -->
        <button
            onclick="calc()"
            class="w-full mt-6 bg-purple-600 hover:bg-purple-700 text-white font-bold py-3 rounded-lg text-left px-5">
            Calculate Result
        </button>


        <!-- Result -->
        <div class="mt-6 bg-gray-100 rounded-xl p-5">

            <h2 class="text-xl font-bold text-purple-700 mb-4">
                Result
            </h2>

            <!-- Total Marks -->
            <p class="text-lg font-bold">
                Total Marks
            </p>

            <p id="totalMarks" class="text-2xl font-bold text-purple-600 mb-4">
                0 / 500
            </p>


            <!-- Percentage -->
            <p class="text-lg font-bold">
                Percentage
            </p>

            <p id="percent" class="text-2xl font-bold text-green-600 mb-4">
                0%
            </p>


            <!-- Grade -->
            <p class="text-lg font-bold">
                Grade
            </p>

            <p id="grade" class="text-2xl font-bold text-blue-600">
                -
            </p>

        </div>

    </div>


    <!-- JavaScript -->
    <script>

        function calc() {

            // Get marks
            let sub1 = Number(document.getElementById("DMGT").value);
            let sub2 = Number(document.getElementById("CAO").value);
            let sub3 = Number(document.getElementById("ED").value);
            let sub4 = Number(document.getElementById("ES").value);
            let sub5 = Number(document.getElementById("MDM").value);

            // Calculate total
            let total = sub1 + sub2 + sub3 + sub4 + sub5;

            // Calculate percentage
            let per = (total / 500) * 100;

            // Calculate grade
            let grade;

            if (per >= 75) {
                grade = "A";
            }
            else if (per >= 65) {
                grade = "B";
            }
            else if (per >= 55) {
                grade = "C";
            }
            else if (per >= 40) {
                grade = "D";
            }
            else {
                grade = "F";
            }

            // Display result
            document.getElementById("totalMarks").innerHTML =
                total + " / 500";

            document.getElementById("percent").innerHTML =
                per.toFixed(2) + "%";

            document.getElementById("grade").innerHTML =
                grade;
        }

    </script>

</body>
</html>
